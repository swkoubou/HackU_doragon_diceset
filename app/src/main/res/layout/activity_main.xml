<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/translate_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- アプリタイトル -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="しゅわりん"
        android:textColor="@color/translate_text"
        android:textSize="28sp"
        android:textStyle="bold" />


    <!-- 説明テキスト -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="～言葉を超える、手の声～"
        android:textColor="@color/translate_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="翻訳方法を選択してね"
        android:textColor="@color/translate_text_light"
        android:textSize="18sp" />

    <!-- 手話翻訳ボタン -->
    <Button
        android:id="@+id/btn_sign_language"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/button_translate_primary"
        android:elevation="4dp"
        android:text="手話の翻訳"
        android:textColor="@color/translate_button_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 音声翻訳ボタン -->
    <Button
        android:id="@+id/btn_voice_translation"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/button_translate_secondary"
        android:elevation="4dp"
        android:text="音声入力"
        android:textColor="@color/translate_button_text"
        android:textSize="18sp"
        android:textStyle="bold" />


</LinearLayout>