<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/translate_background">

    <!-- アプリタイトル -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="しゅわりん？"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/translate_text"
        android:layout_marginBottom="48dp" />


    <!-- 説明テキスト -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="～言葉を超える、手の声～"
        android:textColor="@color/translate_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="翻訳方法を選択してください"
        android:textSize="18sp"
        android:textColor="@color/translate_text_light"
        android:layout_marginBottom="32dp" />

    <!-- 手話翻訳ボタン -->
    <Button
        android:id="@+id/btn_sign_language"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:text="手話翻訳"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_translate_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="4dp" />

    <!-- 音声翻訳ボタン -->
    <Button
        android:id="@+id/btn_voice_translation"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:text="音声翻訳"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_translate_secondary"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="4dp" />

    <!-- テスト用ゲーム開始ボタン -->
    <Button
        android:id="@+id/btn_test_game"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:text="反射神経ゲーム（テスト）"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_translate_test"
        android:textColor="@color/white"
        android:elevation="4dp" />




</LinearLayout>